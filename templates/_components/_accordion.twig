{% if currentUser %}<!-- Begin {{ _self }} -->{% endif %}
{% set list = block is defined ? block.rows.all() : params.rows %}
<div class="accordion !pt-0 pb-12" data-allow-toggle>
	<ul class="accordion-controls" aria-label="Accordion Control Group Buttons">
		{% for item in list %}
		<li class="accordion-item">
			<button
				class="accordion-header"
				id="accordion-control-{{ item.id }}-{{ loop.index }}"
				aria-controls="content-{{ item.id }}-{{ loop.index }}"
				aria-expanded="false"
			>
				{{ item.header ?? params.header ?? '' }}
				<span class="pointer-events-none">
					{{ svg("@webroot/dist/img/icon-plus.svg") }}
					{{ svg("@webroot/dist/img/icon-minus.svg") }}
				</span>
			</button>
			<div class="accordion-panel" id="content-{{ item.id }}-{{ loop.index }}" hidden>
				{{ item.description }}
			</div>
		</li>
		{% endfor %}
	</ul>
</div>

{% if currentUser %}<!-- End {{ _self }} -->{% endif %}
