{% if currentUser %}<!-- Begin {{ _self }} -->{% endif %}
{% set events     	= craft.calendarize.upcoming({section: ['events'], limit:3, relatedTo: entry}) %}
{% set headingText  = block.heading|default('Related Events') %}
{% set buttonText   = 'See All Events' %}
{% if entry.section.handle == 'boardsCommissions' or entry.section.handle == 'topics' or entry.section.handle == 'departments' %}
  {% set buttonLink   = entry.url ~ '/events' %}
{% else %}
  {% set buttonLink   = siteUrl ~ 'events' %}
{% endif %}

{% if block.events|length %}
  {% set events = block.events %}
{% else %}
  {% if events|length == 0 %}
    {% set events = craft.calendarize.between('2017-01-01', now|date('Y-m-d'), {section: ['events'], limit: 3, relatedTo: entry }, 'desc') %}
  {% endif %}
{% endif %}

{% if events|length %}
<div class="mb-12">
  <h2 class="{{ hClass }} {{ addClasses ?? "" }}">{{ headingText }}</h2>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {% for event in events %}
      {% set startTime = (event is instance of('\\unionco\\calendarize\\models\\Occurrence')) ? event.start : event.calendarize.startDate %}
      {% set endTime = (event is instance of('\\unionco\\calendarize\\models\\Occurrence')) ? event.end : event.calendarize.endDate %}
    <a class="shadow card default" href="{{ event.url }}">
      <h4><span>{{ event.title }}</span></h4>
      <p class="flex items-center">{{ svg("@webroot/dist/img/icon-calendar-new.svg") }} <span class="ml-2">{{ startTime.format("l, F d, Y") }}</span></p>
      <p class="flex items-center pt-1">{{ svg("@webroot/dist/img/icon-clock.svg") }} <span class="ml-2">{{ startTime.format("g:ia") }}{{ endTime ? " to " ~ endTime.format("g:ia") : '' }}</span></p>
    </a>
    {% endfor %}
  </div>
  <div class="pt-3">
    {% if not block.hideReadMoreLink %}
        <a class="mt-6 button small secondary" href="{{ buttonLink }}">{{ buttonText }}</a>
    {% endif %}
  </div>
</div>
{% endif %}
{% if currentUser %}<!-- End {{ _self }} -->{% endif %}
